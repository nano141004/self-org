BRAIN_DIR=~/brain

# LLM settings — Phase 2a (used by pal agent; models are LiteLLM names)
PAL_LLM_PRIMARY_MODEL=gemini/gemini-3.5-flash-lite
PAL_LLM_FALLBACK_MODELS=gemini/gemini-3.7-flash,gemini/gemini-3.6-flash
PAL_LLM_EMBEDDING_MODEL=gemini-embedding-2
# Comma-separated; or set GEMINI_API_KEY for a single key
GEMINI_API_KEYS=