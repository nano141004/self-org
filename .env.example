BRAIN_DIR=~/brain

# LLM settings — Phase 2a (used by pal agent; models are LiteLLM names)
PAL_LLM_PRIMARY_MODEL=gemini/gemini-2.5-flash
PAL_LLM_FALLBACK_MODELS=gemini/gemini-2.5-flash-lite,gemini/gemini-2.0-flash
PAL_LLM_EMBEDDING_MODEL=gemini/text-embedding-004
# Comma-separated; or set GEMINI_API_KEY for a single key
GEMINI_API_KEYS=